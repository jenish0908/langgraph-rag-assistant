# Copy to ".streamlit/secrets.toml" for local use (it is gitignored),
# or paste these lines into Streamlit Cloud:
#   App -> Settings -> Secrets
#
# Set ONE of these. The app picks a provider from whichever key is present.

# --- Groq: free, no credit card, ~280 tok/s.  console.groq.com/keys ---
GROQ_API_KEY = "gsk_xxxxxxxxxxxxxxxxxxxx"

# --- Google Gemini: free, generous limits.  aistudio.google.com/apikey ---
# GOOGLE_API_KEY = "AIzaxxxxxxxxxxxxxxxxxxxx"

# --- Anthropic Claude: paid, best quality.  console.anthropic.com ---
# ANTHROPIC_API_KEY = "sk-ant-xxxxxxxxxxxxxxxxxxxx"

# Optional: force a provider instead of auto-detecting.
# LLM_PROVIDER = "groq"
