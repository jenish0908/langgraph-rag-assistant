# Copy to ".env" (gitignored) for local CLI runs, or export these directly.
# The app auto-detects its provider from whichever key is set - see llm.py.
#
# Set ONE of these:

# --- Groq: FREE, no credit card, ~280 tok/s.  console.groq.com/keys ---
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx

# --- Google Gemini: FREE, generous.  aistudio.google.com/apikey ---
# GOOGLE_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxx

# --- Anthropic Claude: PAID, no free tier.  console.anthropic.com ---
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxx

# --- Or set none of the above to run fully offline with Ollama. ---

# Optional overrides
# LLM_PROVIDER=groq          # force a provider instead of auto-detecting
# CHECKPOINT_DB=/tmp/memory.db
